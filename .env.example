PORT=3000

# Upload jobs + failed rows
META_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders_meta

# Comma separated, one URL per shard. Order matters: do not reorder once data exists.
SHARD_URLS=postgres://postgres:postgres@localhost:5432/orders_shard_0,postgres://postgres:postgres@localhost:5432/orders_shard_1,postgres://postgres:postgres@localhost:5432/orders_shard_2

# Google Cloud Storage (auth comes from ADC, no key file needed)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-orders-bucket

BATCH_SIZE=500
MAX_FILE_SIZE_MB=50
